4. Logika JavaScript (Batasan Klik Kursi)
Lokasi: Di bagian tag <script> paling bawah pada file kursi.blade.php.
Tugas: Buat logika JS agar user hanya bisa klik kursi sesuai angka di $jumlahTiket.

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const maksimalTiket = {{ $jumlahTiket }};
        const kursiDipilih = [];
        const btnKursi = document.querySelectorAll('.btn-kursi');
        const inputHiddenKursi = document.getElementById('input-kursi-dipilih');
        const btnSubmit = document.getElementById('btn-submit');

        btnKursi.forEach(btn => {
            btn.addEventListener('click', function() {
                const nomor = this.dataset.nomor;

                if (kursiDipilih.includes(nomor)) {
                    // Batalkan pilihan (Hapus dari array & hilangkan warna merah)
                    kursiDipilih.splice(kursiDipilih.indexOf(nomor), 1);
                    this.classList.remove('bg-red-500'); 
                } else {
                    // Cek apakah sudah melebihi kuota tiket
                    if (kursiDipilih.length >= maksimalTiket) {
                        alert(`Anda hanya memesan ${maksimalTiket} tiket!`);
                        return;
                    }
                    // Tambahkan ke pilihan (Masuk array & beri warna merah)
                    kursiDipilih.push(nomor);
                    this.classList.add('bg-red-500');
                }

                // Masukkan array pilihan ke hidden input (gabung dengan koma)
                inputHiddenKursi.value = kursiDipilih.join(',');
                
                // Nyalakan tombol submit HANYA jika kursi yang dipilih = jumlah tiket
                btnSubmit.disabled = kursiDipilih.length !== maksimalTiket;
            });
        });
    });
</script>

